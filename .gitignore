/target/
**/target/

# Commercial ROMs, firmware and IPL dumps are never committed (PROV-09, QA-04).
/roms/
*.sfc
*.smc
*.swc
*.fig
*.bs
/firmware/

# Fetched test vectors (cargo xtask vectors fetch) and test ROMs (cargo xtask roms fetch, ADR 0014)
/tests/assets/vectors/
/tests/assets/fetched/

.DS_Store
Thumbs.db
desktop.ini

# Commercial ROMs stay ignored; the own test cartridges are built here (ADR 0013).
!/tests/assets/carts/*.sfc
# Third-party test ROMs whose license allows committing them (ADR 0014).
!/tests/assets/third-party/*/*.sfc
